<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<appSettings>
		<add key="Version" value="2.0.0.52"/>
		<add key="ReleaseDate" value="20/10/2026"/>
		<!-- Đường dẫn của trang thuedientu -->
		<add key="ETax_BaseUrl" value="https://thuedientu.gdt.gov.vn" />
		<!-- Đường dẫn trang MISA ASP WebApp -->
		<add key="ASP_App_Url" value="https://testaspapp.misa.vn/App/" />
		<add key="ASP_Api_Url" value="https://testaspapp.misa.vn/Api/" />
		<!-- Chạy trong môi trường Local, không internet -->
		<add key="IsLocalMode" value="false" />
		<!-- Chạy trong môi trường dev - debug -->
		<add key="Env" value="Dev" />
		<add key="EInvoice_API" value="https://hoadondientu.gdt.gov.vn/api"/>
		<add key="EInvoice_Host" value="hoadondientu.gdt.gov.vn"/>
		<!--tải (n) hóa đơn liên tiếp synchronous | Thời gian đợi sau khi tải liên tiếp (n) hóa đơn-->
		<add key="EInvoice_DownloadXML_Delay" value="2|2000"/>
		<!--thời gian timeout đợi response từ thuế trả về-->
		<add key="EInvoice_Timeout" value="10000"/>
		<!--tải (n) trang liên tiếp synchronous | Thời gian đợi sau khi tải liên tiếp (n) trang-->
		<add key="EInvoice_FetchList_Delay" value="2|2000"/>
		<!--nếu lỗi (n) lần cal thì break và throw ex | thời gian đợi sau mỗi lần lỗi-->
		<add key="EInvoice_Request_Config" value="5|10000"/>
		<!--Thời gian timeout khi gửi về kế toán (đơn vị tính là s)-->
		<add key="ASPAccounting_Timeout" value="120"/>
		<!-- dùng để test trường hợp chưa build ASP_Api_Url  -->
		<add key="FORCE_CHECK_VERSION" value="false"/>
		<!--lấy config từ server-->
		<add key="Get_Server_Config" value="false"/>
		<add key="IsCompressData" value="false"/>
		<!-- Có lưu lại log request hay không-->
		<add key="IsSaveRequestBody" value="false"/>
		<!-- Có fake token kết nối trong local hay không-->
		<!--<add key="IsFakeToken" value="false"/>-->
		<!-- Có lấy hóa đơn máy tính tiền không-->
		<add key="IsGetInvoiceFromMachine" value="false"/>
		<add key="IsGetEInvoice" value="true"/>
		<!-- Đường dẫn của trang dịch vụ công -->
		<add key="Dvc_BaseUrl" value="https://dichvucong.gdt.gov.vn"/>
		<!-- Cờ cấu hình chạy qua luồng cũ (Thuế điện tử) thay vì Dịch vụ công: true/false (mặc định: false) -->
		<add key="UseOldETaxFlow" value="false" />
	</appSettings>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5.1"/>
	</startup>
</configuration>